{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Solis",
  "scopeName": "source.solis",
  "fileTypes": [
    "sl"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#type-decl"
    },
    {
      "include": "#func-decl"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#generics"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#support-calls"
    },
    {
      "include": "#types"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.solis",
          "match": "//.*$"
        },
        {
          "name": "comment.block.solis",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "imports": {
      "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.import.solis"
        },
        "2": {
          "name": "entity.name.namespace.solis"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.solis",
          "match": "\\b(if|else|while|for|in|switch|case|return|break|continue)\\b"
        },
        {
          "name": "keyword.other.solis",
          "match": "\\b(arena|import)\\b"
        },
        {
          "name": "storage.modifier.solis",
          "match": "\\b(static|mut|weak|extern)\\b"
        },
        {
          "name": "storage.type.solis",
          "match": "\\b(let|var|func|struct|enum|interface)\\b"
        },
        {
          "name": "variable.language.this.solis",
          "match": "\\bthis\\b"
        },
        {
          "name": "entity.name.tag.default.solis",
          "match": "\\bdefault\\b(?=\\s*:)"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.solis",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.solis",
          "match": "\\bnull\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.solis",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.solis",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.solis",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b|\\b[0-9][0-9_]*[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.solis",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.solis",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.solis",
          "match": "\\\\[ntr0\\\\\"$]"
        },
        {
          "name": "meta.embedded.expression.solis",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.interpolation.begin.solis"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.interpolation.end.solis"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "type-decl": {
      "patterns": [
        {
          "match": "\\b(struct|enum|interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.solis"
            },
            "2": {
              "name": "entity.name.type.solis"
            }
          }
        }
      ]
    },
    "func-decl": {
      "patterns": [
        {
          "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.solis"
            },
            "2": {
              "name": "entity.name.function.solis"
            }
          }
        }
      ]
    },
    "generics": {
      "patterns": [
        {
          "match": "(?<=[A-Za-z0-9_\\]])\\[(?=[A-Za-z_])",
          "name": "punctuation.definition.generic.begin.solis"
        }
      ]
    },
    "support-calls": {
      "patterns": [
        {
          "name": "support.function.builtin.solis",
          "match": "\\b(print|len|push|sqrt|abs)\\b(?=\\s*\\()"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.solis"
            }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.builtin.solis",
          "match": "\\b(int|float|bool|str)\\b"
        },
        {
          "comment": "PascalCase identifiers are types/enum variants by convention",
          "name": "entity.name.type.solis",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "comment": "Catch-all for params, locals and field names left unscoped by everything above",
          "name": "variable.other.solis",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.solis",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.solis",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.compound.solis",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.assignment.solis",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.solis",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.optional.solis",
          "match": "\\?\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.solis",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.solis",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.brackets.begin.solis",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.solis",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.parens.begin.solis",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.solis",
          "match": "\\)"
        },
        {
          "name": "punctuation.separator.colon.solis",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.solis",
          "match": ","
        },
        {
          "name": "punctuation.terminator.solis",
          "match": ";"
        },
        {
          "name": "punctuation.accessor.solis",
          "match": "\\."
        }
      ]
    }
  }
}
